# ---------------------------------------------------------------------------
# FINDIT employee app (Expo) — copy to apps/employee-mobile/.env
#
# EXPO_PUBLIC_* is inlined into the app binary at build time. Anyone can
# extract these from a shipped .ipa or .apk, so PUBLIC VALUES ONLY.
# Store staff sign in with their own account; the app never holds elevated
# credentials. Responding to a request goes through an Edge Function.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY here, under any name.
# ---------------------------------------------------------------------------

# PUBLIC, required. Same value as the web app's NEXT_PUBLIC_SUPABASE_URL.
# Supabase Dashboard → Project Settings → Data API → Project URL.
EXPO_PUBLIC_SUPABASE_URL=

# PUBLIC, required. Same value as the web app's NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Supabase Dashboard → Project Settings → API Keys → anon / public.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PUBLIC, optional, not yet read by any code. Reserved for links back to the
# web app, where owners and managers do team and account admin. Set it to the
# production origin once the domain is live, e.g. https://<your-domain>
EXPO_PUBLIC_APP_URL=

# PUBLIC, optional, not yet read by any code. lib/monitoring.ts is a no-op
# stub. A Sentry DSN is designed to be public. Fill in after wiring Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Set outside this file
#   app.json → expo.extra.eas.projectId   real EAS project ID (see LAUNCH_SETUP.md)
#   eas.json → submit.production.ios.ascAppId   App Store Connect app ID
#   EAS build secrets (expo.dev → Project → Secrets) for anything sensitive;
#   EXPO_PUBLIC_* values above can also live there instead of a local file.
# ---------------------------------------------------------------------------
