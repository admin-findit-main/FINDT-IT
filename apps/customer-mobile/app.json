{
  "expo": {
    "name": "FINDIT",
    "slug": "find-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "findit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findit.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FINDIT uses the camera so you can attach a product photo.",
        "NSPhotoLibraryUsageDescription": "FINDIT uses your photos so you can attach a product image.",
        "NSLocationWhenInUseUsageDescription": "FINDIT uses your location to find nearby stores. You can enter a ZIP instead."
      }
    },
    "android": {
      "package": "com.findit.customer",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FINDIT uses the camera so you can attach a product photo.",
          "photosPermission": "FINDIT uses your photos so you can attach a product image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E5231B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "860ebbc7-a62b-43c2-bbd2-d6307627b5b2"
      }
    }
  }
}
