{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@findit/types": ["../../packages/types/src/index.ts"],
      "@findit/domain": ["../../packages/domain/src/index.ts"],
      "@findit/domain/*": ["../../packages/domain/src/*"],
      "@findit/supabase-client": ["../../packages/supabase-client/src/index.ts"],
      "@findit/supabase-client/*": ["../../packages/supabase-client/src/*"],
      "@findit/theme": ["../../packages/theme/src/index.ts"],
      "@findit/theme/tokens": ["../../packages/theme/src/tokens.ts"],
      "@findit/theme/native": ["../../packages/theme/src/native.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
