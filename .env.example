# ---------------------------------------------------------------------------
# FINDIT — web app (Next.js at repo root)
#
# Copy to .env.local for local dev. In production these are set in the Vercel
# dashboard (Project → Settings → Environment Variables), NOT in a file.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. Treat every
# NEXT_PUBLIC_* value as fully public. Everything else is server-only.
# ---------------------------------------------------------------------------


# --- Supabase (required) ---------------------------------------------------

# PUBLIC. Supabase Dashboard → Project Settings → Data API → Project URL.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC. Supabase Dashboard → Project Settings → API Keys → anon / public.
# The classic anon JWT. Safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PUBLIC, OPTIONAL. Newer "publishable" key (sb_publishable_...) from the same
# API Keys page. Used only as a fallback when the anon JWT above is empty; see
# getSupabasePublishableKey() in src/lib/config/env.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — SERVER ONLY. Supabase Dashboard → Project Settings → API Keys →
# service_role. Bypasses every RLS policy. Set it in Vercel with the
# "Sensitive" flag. Never prefix it with NEXT_PUBLIC_, never put it in an Expo
# app, never paste it into a chat or a client-side file.
SUPABASE_SERVICE_ROLE_KEY=


# --- App URL ---------------------------------------------------------------

# PUBLIC. Canonical origin, no trailing slash.
#   local dev:  http://localhost:3002
#   production: https://<your-domain>
# Read by the forgot-password screen to build the password-reset redirect. The
# same value must be added to Supabase → Authentication → URL Configuration as
# the Site URL, plus https://<your-domain>/** (and local http://localhost:3002/**
# during development) as redirect URLs, or reset and confirmation links will bounce.
NEXT_PUBLIC_APP_URL=http://localhost:3002


# --- Runtime mode flags (server only) --------------------------------------

# Offline in-memory fixtures instead of Supabase. "true" only for Vitest and
# offline UI work. MUST be false in pilot and production.
FINDIT_DEMO_MODE=false

# Closed pilot: relaxes usage caps, shows Beta / pilot banners, hides Stripe.
# Set to false the day you start charging.
FINDIT_PILOT_MODE=true

# Ignores customer Find caps AND store routing caps. QA escape hatch only.
# Pilot mode does NOT skip consumer Find caps (5 / 25).
FINDIT_BYPASS_PLAN_LIMITS=false

# PUBLIC, OPTIONAL. Client-side demo guard read by src/lib/supabase/realtime.ts
# to skip opening realtime channels. Leave unset outside demo mode.
NEXT_PUBLIC_FINDIT_DEMO_MODE=


# --- App Store listings (public, optional) ---------------------------------
# Leave empty until the listing exists. The marketing page then says
# "coming soon" and keeps /signup as a web preview. Do not invent an App ID.

NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=


# --- Optional dedicated hosts (same Vercel app) ----------------------------
# Leave empty. Host-based routing is off until these match a real hostname.
# Example later: business.findit.app  hub.findit.app  admin.findit.app
# Still one Next.js project — not four deploys. See src/lib/config/hosts.ts.

FINDIT_BUSINESS_HOST=
FINDIT_HUB_HOST=
FINDIT_ADMIN_HOST=


# --- Transactional email (Resend) ------------------------------------------

# SECRET. Resend Dashboard → API Keys. Replace re_xxxxxxxxx with the real key.
# Used by the send-email Edge Function (not by the Next.js browser bundle).
# Also set the same value as a Supabase secret:
#   npx supabase secrets set RESEND_API_KEY=re_...
RESEND_API_KEY=

# Sender shown to customers. Must be on a domain verified in Resend.
RESEND_FROM=FINDIT <hello@askfindit.com>

# SECRET. Generated when you enable Auth → Hooks → Send Email for
# /functions/v1/send-email. Looks like v1,whsec_...
SEND_EMAIL_HOOK_SECRET=


# --- Payments (not implemented yet) ----------------------------------------
# Reserved names only. There is no Stripe SDK, checkout, or webhook in the
# codebase; leave all four blank until billing is actually built.

# SECRET. Stripe Dashboard → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=
# PUBLIC. Stripe Dashboard → Developers → API keys → Publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SECRET. Stripe Dashboard → Developers → Webhooks → signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=


# --- Local dev convenience -------------------------------------------------

# OPTIONAL. Extra origin allowed to hit the dev server, for testing on a phone
# over Wi-Fi. Your machine's LAN IP, e.g. 192.168.1.157. Dev only — it has no
# effect on a production build. Get it with: ipconfig getifaddr en0
FINDIT_DEV_ORIGIN=


# ---------------------------------------------------------------------------
# NOT set here — listed so nothing gets missed
# ---------------------------------------------------------------------------
#
# Supabase Edge Functions (create-and-route-request, respond-to-request) read
# their own env from the Supabase platform, not from this file:
#
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#       Injected automatically by Supabase. Do not set these yourself.
#   FINDIT_PILOT_MODE, FINDIT_BYPASS_PLAN_LIMITS
#       Optional overrides. Default when unset: pilot mode ON.
#   EXPO_ACCESS_TOKEN
#       Optional. Expo push still sends without it. Set it in production to
#       reduce abuse of the Expo push API:
#       npx supabase secrets set EXPO_ACCESS_TOKEN=...
#
# Mobile apps: see apps/customer-mobile/.env.example and
# apps/employee-mobile/.env.example.
